# VeldMind · example settings
# Copy this file to .env and fill in real values.
# Never commit .env.

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only. Never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- API (FastAPI) ----------
API_BASE_URL=http://localhost:8000
API_ENV=development
JWT_AUDIENCE=authenticated

# ---------- Satellite & weather ----------
# Copernicus Data Space (Sentinel 2)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Open-Meteo needs no key for non-commercial use
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ---------- SMS & USSD ----------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=VELDMIND

# ---------- Push notifications ----------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=./secrets/fcm.json

# ---------- AI advisor ----------
LLM_API_KEY=
LLM_MODEL=

# ---------- Farm gateway ----------
GATEWAY_ID=gw-0001
GATEWAY_SERVICE_KEY=
CHIRPSTACK_API_URL=http://localhost:8080
CHIRPSTACK_API_TOKEN=
MQTT_BROKER_URL=mqtt://localhost:1883
